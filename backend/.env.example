OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
JIMA_ACCESS_TOKEN=change-this-token-before-hosting
PORT=3000

# Jima chat limits (optional; defaults shown)
# Max tokens in a single Jima reply
JIMA_MAX_OUTPUT_TOKENS=900
# Max conversation messages accepted per request
JIMA_MAX_MESSAGES=60

# Courses store (libSQL / Turso). Leave both blank for local development:
# the backend then uses a local SQLite file at backend/data/courses.db.
# In production (e.g. Render) set these to a Turso database so data survives
# redeploys:
#   turso db create bgu-companion
#   turso db show bgu-companion --url      -> TURSO_DATABASE_URL
#   turso db tokens create bgu-companion   -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
