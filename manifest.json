{
  "manifest_version": 3,
  "name": "BGU Companion",
  "description": "BGU student companion: quick Moodle course access + shortcuts to Gezer and student systems.",
  "version": "1.2.0",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "BGU Companion"
  },
  "options_page": "src/options/options.html",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": ["tabs", "storage", "sidePanel", "downloads"],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "host_permissions": [
    "https://moodle.bgu.ac.il/*",
    "https://gezer1.bgu.ac.il/*",
    "https://bgu4u22.bgu.ac.il/*",
    "https://bgu4u.bgu.ac.il/*",
    "https://portal.bgu.ac.il/*",
    "http://localhost:3000/*",
    "https://bgu-companion-chrome-extension.onrender.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://moodle.bgu.ac.il/moodle/*",
        "https://gezer1.bgu.ac.il/*",
        "https://bgu4u22.bgu.ac.il/*",
        "https://bgu4u.bgu.ac.il/*",
        "https://portal.bgu.ac.il/*"
      ],
      "js": ["src/data/courses-data.js", "src/content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
